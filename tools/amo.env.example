# Skopiuj do ~/.config/firefox-screenshot-plugin/amo.env i uzupełnij.
#
# Wygeneruj dane na: https://addons.mozilla.org/developers/addon/api/key/
#   AMO_JWT_ISSUER = "API key" (JWT issuer)
#   AMO_JWT_SECRET = "API secret" (JWT secret)
#
# Ten plik NIE trafia do repozytorium (patrz .gitignore).

AMO_JWT_ISSUER="user:12345678:123"
AMO_JWT_SECRET="tu-wklej-dlugi-sekret"
